
#include <stdio.h>
int main() {
    int choice;
    float balance = 5000, amount;
    do {
        printf("\n--- BANK MANAGEMENT SYSTEM ---\n");
        printf("1. Check Balance\n2. Deposit\n3. Withdraw\n4. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);
        if (choice == 1)
            printf("Balance: Rs. %.2f\n", balance);
        else if (choice == 2) {
            printf("Enter deposit amount: ");
            scanf("%f", &amount);
            if (amount > 0) balance += amount;
            else printf("Invalid amount!\n");
        } else if (choice == 3) {
            printf("Enter withdrawal amount: ");
            scanf("%f", &amount);
            if (amount > 0 && amount <= balance)
                balance -= amount;
            else printf("Invalid amount or insufficient balance!\n");
        } else if (choice != 4)
            printf("Invalid choice!\n");
    } while (choice != 4);
    printf("Thank you for using our bank!\n");
    return 0;
}
